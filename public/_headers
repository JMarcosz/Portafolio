# Cabeceras para Cloudflare Pages.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Cloudflare aplica las reglas de arriba a abajo; si dos coinciden y fijan la
# misma cabecera, gana la ULTIMA. Por eso el `/*` general va primero y la regla
# especifica de `/_astro/*` va despues.

# robots.txt: nunca cachear (evita que un CDN sirva una version vieja tras un
# cambio) y X-Robots-Tag noindex para que el propio archivo no aparezca como
# resultado en las SERPs de Google.
/robots.txt
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

# llms.txt: nunca cachear y forzar el content-type de texto plano.
/llms.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

# Sitemaps: cache corto (1h) para que Google vea cambios pronto, pero noindex
# porque el XML del sitemap no debe aparecer como resultado de búsqueda.
/sitemap*.xml
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: noindex, follow

# Gemelos .md de cada pagina (ver middleware.ts): solo existe el mecanismo de
# negociacion por Accept en Vercel, pero si alguien pide el .md directo aqui
# tambien debe llegar como texto plano y no indexarse aparte del HTML.
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex, nofollow

# HTML y todo lo demas: sin caché persistente. El navegador revalida en cada
# visita (respuesta 304 si no cambió), así cada deploy se ve al instante.
#
# NOTA: comprobado en vivo con curl (2026-09-02) que estas cabeceras de este
# bloque `/*` — X-Content-Type-Options, X-Frame-Options, Referrer-Policy,
# Permissions-Policy, Content-Security-Policy — NO llegan al navegador en
# Vercel (solo Strict-Transport-Security aparece, y es probablemente el
# default automático de Vercel para dominios HTTPS, no este archivo). La
# copia real y activa de estas cabeceras está ahora en vercel.json.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # GTM + GA4 + Vercel Analytics: googletagmanager.com sirve gtm.js/gtag; GA4 manda
  # los hits a *.google-analytics.com (incluye region1.*); el <noscript> de GTM abre
  # un iframe a googletagmanager.com/ns.html. Vercel Analytics va por /_vercel (mismo origen).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.web3forms.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net; frame-src https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;

# Bundles de Astro: el hash en el nombre cambia con cada build, así que su
# contenido es inmutable y se puede cachear un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes .webp y certificados descargables: no cambian tras publicarse,
# cachear 30 días evita redescargarlos en cada visita.
#
# NOTA: esta regla de /*.webp NO se aplica en Vercel (comprobado en vivo con
# curl: /_astro/* sí toma su Cache-Control de este archivo, /*.webp no) — un
# comodín de sufijo sin carpeta no calza con el matching de Vercel para
# _headers. La regla real y activa está en vercel.json (usa regex). Se deja
# esta también por si el sitio vuelve a correr en Cloudflare Pages/Netlify,
# donde sí funciona.
/*.webp
  Cache-Control: public, max-age=2592000

/Certificados Portafolio/*
  Cache-Control: public, max-age=2592000
