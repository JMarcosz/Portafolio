---
// 404 propio: sin esto Netlify sirve su página genérica, sin el layout ni forma
// de volver al sitio.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getContent } from "../i18n";

const t = getContent("es");
---

<Layout
  title="Página no encontrada | Jean Marte"
  description="La página que buscas no existe."
  robots="noindex, follow"
>
  <Header />
  <main id="contenido" tabindex="-1" class="mx-auto flex min-h-[70vh] max-w-3xl flex-col justify-center px-6 py-32">
    <p class="eyebrow mb-4">Error 404</p>
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl text-white">Esta página no existe</h1>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-white">
      El enlace que seguiste está roto o la página cambió de dirección. Desde el inicio podés llegar a todo lo demás.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={t.home} class="btn-primary">Volver al inicio</a>
      <a
        href={t.home}
        class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-white/30 hover:bg-white/5"
      >
        Ver proyectos
      </a>
    </div>
  </main>
  <Footer />
</Layout>
