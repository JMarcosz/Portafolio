---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServicePage from "../../components/ServicePage.astro";
import { getContent, getServicePages } from "../../i18n";
import { GEOGRAPHIC_AREAS } from "../../i18n/keywords";

export function getStaticPaths() {
  return getServicePages().map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const t = getContent("es");
const site = "https://www.jeanmarte.com";
const url = `${site}/servicios/${service.slug}/`;

// `Service` con `areaServed`: hasta ahora el `hasOfferCatalog` de la home
// declaraba servicios que no tenían ninguna URL detrás. Ahora este sí la tiene.
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.metaDescription,
  url,
  serviceType: service.eyebrow,
  areaServed: GEOGRAPHIC_AREAS,
  provider: {
    "@type": "Person",
    name: "Jean Marte (Jean Marco Marte)",
    url: `${site}/`,
  },
  inLanguage: "es-DO",
};

// El FAQPage es de los pocos resultados enriquecidos que Google sigue mostrando
// ampliamente, y estas preguntas son las que el visitante trae escritas.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t.nav[0]?.label ?? "Inicio", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: "Servicios", item: `${site}/#servicios` },
    { "@type": "ListItem", position: 3, name: service.title, item: url },
  ],
};
---

<!-- Sin par en inglés a propósito: estas páginas son sólo en español. `enHref`
     apunta a la home EN para que el toggle del header lleve a algún sitio
     válido, y el hreflang no promete una traducción que no existe. -->
<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  esHref={`/servicios/${service.slug}/`}
  enHref="/en/"
  ogType="website"
  extraSchema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <Header otherHref="/en/" />
  <main id="contenido" tabindex="-1" class="pt-16">
    <ServicePage service={service} />
  </main>
  <Footer />
</Layout>
