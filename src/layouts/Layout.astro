---
import "../styles/global.css";
import "../styles/scroll-engine.css";
// Se importa con ?url para que Vite devuelva la ruta final con hash: sin esto la
// fuente recién se descubre al parsear el CSS, provocando FOUT en la primera pintura.
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { getContent, normalizeLocale } from "../i18n";
import { BRAND_VARIANTS, KNOWS_ABOUT_LIST, SEO_KEYWORDS_ES, SEO_KEYWORDS_EN } from "../i18n/keywords";
import Analytics from "@vercel/analytics/astro";

interface Props {
  image?: string;
  /**
   * Dimensiones REALES de `image`. Estaban fijas en 1200x1200, que sólo era
   * cierto para el og-image por defecto: los casos de estudio pasaban la captura
   * de página completa (hasta 1200x6456) y seguían declarando un cuadrado, así
   * que WhatsApp y LinkedIn recortaban la previsualización a ciegas.
   */
  imageWidth?: number;
  imageHeight?: number;
  /** Título y descripción propios (páginas de caso de estudio). */
  title?: string;
  description?: string;
  /** Par de idiomas de ESTA página, para canonical/hreflang. */
  esHref?: string;
  enHref?: string;
  /** Tipo de Open Graph: la home es un perfil, un caso de estudio es un artículo. */
  ogType?: string;
  /** Imagen a precargar por ser la candidata a LCP de esta página. */
  preloadImage?: string;
  /** JSON-LD propio de la página, además del Person que va en todas. */
  extraSchema?: unknown[];
}

const locale = normalizeLocale(Astro.currentLocale);
const t = getContent(locale);
const keywords = locale === "en" ? SEO_KEYWORDS_EN.join(", ") : SEO_KEYWORDS_ES.join(", ");

const {
  image = "/og-image.jpg",
  imageWidth = 1200,
  imageHeight = 1200,
  title = t.meta.title,
  description = t.meta.description,
  esHref = "/",
  enHref = "/en/",
  ogType = "profile",
  preloadImage,
  extraSchema = [],
} = Astro.props;

// Astro.site viene de `site` en astro.config.mjs — hace falta para que canonical
// y las imágenes de Open Graph sean URLs absolutas (las relativas no funcionan
// al compartir el enlace en WhatsApp/LinkedIn, que no resuelven contra el HTML).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const esURL = new URL(esHref, Astro.site);
const enURL = new URL(enHref, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jean Marte",
  alternateName: BRAND_VARIANTS.filter((n) => n !== "Jean Marte"),
  givenName: "Jean Marco",
  familyName: "Marte",
  jobTitle: t.meta.jobTitle,
  url: Astro.site?.toString(),
  image: `${Astro.site}logo-web.png`,
  logo: `${Astro.site}logo-web.png`,
  email: "mailto:jeanmarte22@gmail.com",
  address: { "@type": "PostalAddress", addressCountry: "DO" },
  sameAs: [
    "https://www.linkedin.com/in/jean-marte-a6b070178/",
    "https://github.com/JMarcosz",
    "https://www.instagram.com/jeanwebdesing/",
  ],
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Universidad Domínico Americana (UNICDA)" },
    { "@type": "CollegeOrUniversity", name: "Instituto Tecnológico de las Américas (ITLA)" },
  ],
  knowsAbout: KNOWS_ABOUT_LIST,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicon + íconos de Google Search y PWA: generados desde logo-web.jpeg -->
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="144x144" href="/favicon-144x144.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#050505" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {
      preloadImage && (
        <link
          rel="preload"
          href={preloadImage}
          imagesrcset="/foto_personal_384.webp 384w, /foto_personal_768.webp 768w"
          imagesizes="(min-width: 1024px) 384px, (min-width: 640px) 288px, 224px"
          as="image"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Jean Marte (Jean Marco Marte)" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Jean Marte" />
    <meta property="og:locale" content={t.meta.localeOg} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    {ogType === "profile" && <meta property="profile:first_name" content="Jean Marco" />}
    {ogType === "profile" && <meta property="profile:last_name" content="Marte" />}
    {ogType === "profile" && <meta property="profile:username" content="jeanmarte" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {extraSchema.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <!-- overflow-x-clip (no -hidden): `hidden` obligaría a overflow-y a `auto` y
       convertiría al body en contenedor de scroll, interfiriendo con Lenis. -->
  <body class="overflow-x-clip bg-bg text-ink">
    <a href="#contenido" class="skip-link">{t.header.skipToContent}</a>

    <!-- Campos de partículas globales: capas fijas detrás de todo el contenido,
         continuas al scrollear por todas las secciones.

         Las DOS viven acá, fuera del túnel, y no dentro de la sección que las usa:
         un `position: fixed` dentro de un ancestro con transform se ancla a ese
         ancestro en vez de al viewport, y groups.ts transforma los grupos. -->
    <canvas id="bg-particles" class="pointer-events-none fixed inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
    <canvas id="hero-particles" class="pointer-events-none fixed inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
    <div class="z-progress" aria-hidden="true"></div>

    <div id="preloader" aria-hidden="true">
      <div class="preloader-panel l"></div>
      <div class="preloader-panel r"></div>
      <span class="preloader-mark">JM</span>
    </div>

    <slot />

    <script>
      import "../scripts/smooth-scroll";
      import { gsap, prefersReducedMotion } from "../scripts/motion";
      import { initParticleField } from "../scripts/particle-field";
      import { initGroups } from "../scripts/groups";

      // Fondo global disperso, continuo en todas las secciones.
      const bgCanvas = document.getElementById("bg-particles") as HTMLCanvasElement | null;
      if (bgCanvas) initParticleField(bgCanvas, { count: 90 });

      // Capa densa del Hero, encima de la anterior. Sólo existe donde hay Hero:
      // en una página de caso de estudio no hay nada que ambientar y serían 210
      // partículas repintándose por nada.
      const heroCanvas = document.getElementById("hero-particles") as HTMLCanvasElement | null;
      if (heroCanvas && document.querySelector("[data-hero-section]")) {
        initParticleField(heroCanvas, {
          count: 210,
          visible: () => window.scrollY < window.innerHeight * 1.6,
        });
      } else {
        heroCanvas?.remove();
      }

      initGroups();

      const preloader = document.getElementById("preloader");
      const mark = preloader?.querySelector<HTMLElement>(".preloader-mark");
      const panelL = preloader?.querySelector<HTMLElement>(".preloader-panel.l");
      const panelR = preloader?.querySelector<HTMLElement>(".preloader-panel.r");

      const finish = () => {
        preloader?.remove();
        window.dispatchEvent(new CustomEvent("preloader:done"));
      };

      if (!preloader || !mark || !panelL || !panelR || prefersReducedMotion()) {
        finish();
      } else {
        // La cortina se lleva por delante el LCP: nada del contenido cuenta como
        // pintado hasta que se abre. Duraba 1.45s (0.5 + 0.25 + 0.7) ANTES de
        // sumar la red y el parseo de GSAP, lo que dejaba el <h1> visible bien
        // pasados los 2.5s que Search Console marca como umbral. Ahora son 0.6s.
        gsap
          .timeline({ onComplete: finish })
          .to(mark, { opacity: 1, scale: 1, duration: 0.28, ease: "expo.out" })
          .to([panelL], { xPercent: -100, duration: 0.45, ease: "expo.inOut" }, "open")
          .to([panelR], { xPercent: 100, duration: 0.45, ease: "expo.inOut" }, "open")
          .to(mark, { opacity: 0, duration: 0.2, ease: "power2.out" }, "open");
      }
    </script>
    <Analytics />
  </body>
</html>
