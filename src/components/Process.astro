---
import { getContent } from "../i18n";
const { process: proc } = getContent(Astro.currentLocale);
---

<section id="proceso" aria-labelledby="proceso-title" class="mx-auto max-w-6xl section-y px-6">
  <p class="eyebrow mb-4">{proc.eyebrow}</p>
  <h2 id="proceso-title" class="text-4xl font-bold tracking-tight">
    {proc.heading1}<br />
    <span class="font-extrabold">{proc.heading2}</span>
  </h2>
  <p class="mt-6 max-w-md text-sm leading-relaxed text-white/50">{proc.intro}</p>

  <ol class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      proc.items.map((item, i) => (
        <li data-process-card class="card p-6">
          <span class="text-xs text-white/55">[ {String(i + 1).padStart(2, "0")} ]</span>
          <h3 class="mt-3 text-base font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/50">{item.description}</p>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { gsap, TOKENS } from "../scripts/motion";
  import { registerSection } from "../scripts/stage";

  const cards = gsap.utils.toArray<HTMLElement>("[data-process-card]");

  registerSection("proceso", {
    prepare: () => gsap.set(cards, { autoAlpha: 0, y: 24 }),
    reveal: () => gsap.timeline().to(cards, { autoAlpha: 1, y: 0, stagger: TOKENS.stagger.tight, ...TOKENS.revealMd }),
    settle: () => gsap.set(cards, { autoAlpha: 1, y: 0 }),
  });
</script>
