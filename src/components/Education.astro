---
import { education } from "../data/site";
---

<section id="formacion" data-slide-section class="mx-auto max-w-6xl px-6 py-24">
  <p class="eyebrow mb-4">Formación académica</p>
  <h2 class="text-4xl font-bold tracking-tight">
    Mi <span class="font-extrabold">Formación</span>
  </h2>

  <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2">
    {
      education.map((item) => (
        <article data-edu-card class="card p-6">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-wider text-white/40">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M16 2v4M8 2v4M3 10h18" />
            </svg>
            {item.period}
          </span>

          <h3 class="mt-3 text-base font-semibold">{item.degree}</h3>

          <p class="mt-1 flex items-center gap-1.5 text-xs text-white/50">
            <svg data-edu-icon width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 10 12 5 2 10l10 5 10-5Z" />
              <path d="M6 12v5c0 1.1 2.69 2 6 2s6-.9 6-2v-5" />
            </svg>
            {item.institution}
          </p>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap, floatIdle, prefersReducedMotion } from "../scripts/motion";

  const cards = document.querySelectorAll<HTMLElement>("[data-edu-card]");

  if (prefersReducedMotion()) {
    gsap.set(cards, { autoAlpha: 1 });
  } else {
    // Familia de entrada: inclinación que se asienta — rotateZ, no translateY.
    // Tratamiento deliberadamente más quieto que sus vecinas (Experiencia, Certificados).
    gsap.set(cards, { autoAlpha: 0, rotateZ: -4 });
    gsap.set("[data-edu-icon]", { rotate: -8, scale: 0.8 });

    gsap.to(cards, {
      autoAlpha: 1,
      rotateZ: 0,
      duration: 0.7,
      stagger: 0.1,
      ease: "power3.out",
      scrollTrigger: { trigger: "#formacion", start: "top 78%", once: true },
      onComplete: () => {
        gsap.to("[data-edu-icon]", { rotate: 0, scale: 1, duration: 0.4, stagger: 0.1, ease: "back.out(1.7)" });
        cards.forEach((card) => floatIdle(card, 2));
      },
    });
  }
</script>
