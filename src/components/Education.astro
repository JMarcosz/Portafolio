---
import { getContent } from "../i18n";
const { education: edu } = getContent(Astro.currentLocale);
const education = edu.items;
---

<section id="formacion" aria-labelledby="formacion-title" class="mx-auto max-w-6xl px-6 py-24">
  <p class="eyebrow mb-4">{edu.eyebrow}</p>
  <h2 id="formacion-title" class="text-4xl font-bold tracking-tight">
    {edu.heading1} <span class="font-extrabold">{edu.heading2}</span>
  </h2>

  <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2">
    {
      education.map((item) => (
        <article data-edu-card class="card p-6">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-wider text-white/55">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M16 2v4M8 2v4M3 10h18" />
            </svg>
            {item.period}
          </span>

          <h3 class="mt-3 text-base font-semibold">{item.degree}</h3>

          <p class="mt-1 flex items-center gap-1.5 text-xs text-white/50">
            <svg data-edu-icon width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 10 12 5 2 10l10 5 10-5Z" />
              <path d="M6 12v5c0 1.1 2.69 2 6 2s6-.9 6-2v-5" />
            </svg>
            {item.institution}
          </p>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap, floatIdle, TOKENS } from "../scripts/motion";
  import { registerSection } from "../scripts/stage";

  const cards = gsap.utils.toArray<HTMLElement>("[data-edu-card]");
  const icons = gsap.utils.toArray<HTMLElement>("[data-edu-icon]");

  // Familia de entrada: inclinación que se asienta — rotateZ, no translateY.
  registerSection("formacion", {
    prepare: () => {
      gsap.set(cards, { autoAlpha: 0, rotateZ: -4 });
      gsap.set(icons, { rotate: -8, scale: 0.8 });
    },
    reveal: () =>
      gsap
        .timeline({ onComplete: () => cards.forEach((card) => floatIdle(card, 2)) })
        .to(cards, { autoAlpha: 1, rotateZ: 0, stagger: TOKENS.stagger.normal, ...TOKENS.revealMd }, 0)
        .to(icons, { rotate: 0, scale: 1, stagger: TOKENS.stagger.tight, ...TOKENS.bounce }, 0.2),
    settle: () => {
      gsap.set(cards, { autoAlpha: 1, rotateZ: 0 });
      gsap.set(icons, { rotate: 0, scale: 1 });
    },
  });
</script>
