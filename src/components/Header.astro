---
import { getContent, normalizeLocale, localeHome } from "../i18n";

interface Props {
  /** Equivalente de ESTA página en el otro idioma. Por defecto, la home. */
  otherHref?: string;
}

const locale = normalizeLocale(Astro.currentLocale);
const t = getContent(locale);
const otherLocale = locale === "es" ? "en" : "es";
const { otherHref = localeHome(otherLocale) } = Astro.props;

// Los enlaces del nav se prefijan con la home del idioma. Un `#proyectos` a
// secas no lleva a ningún lado desde /proyectos/<slug>: el ancla no existe en
// esa página. Con `/#proyectos` funciona desde cualquier ruta, y en la home
// groups.ts lo intercepta igual porque compara el pathname.
const home = t.home;
const nav = t.nav.map((item) => ({ ...item, href: `${home}${item.href}` }));
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10">
  <div class="header-bg pointer-events-none absolute inset-0 -z-10"></div>

  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href={home} data-header-mark class="text-sm font-bold tracking-tight opacity-0">Jean Marte</a>

    <nav data-desktop-nav class="relative hidden items-center gap-5 lg:flex xl:gap-7">
      <span
        id="nav-rail"
        class="pointer-events-none absolute bottom-[-1px] h-[2px] rounded-full bg-white opacity-0"
      ></span>
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-nav-link
            data-header-item
            class="nav-link whitespace-nowrap text-[11px] font-medium uppercase tracking-[0.15em] text-white/50 opacity-0 transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div data-header-actions class="flex items-center gap-2">
      <a
        href={otherHref}
        hreflang={otherLocale}
        data-header-item
        aria-label={t.header.langAria}
        class="flex h-8 items-center gap-1.5 rounded-lg border border-white/10 px-2.5 text-[11px] font-semibold uppercase tracking-[0.15em] opacity-0 transition-colors hover:border-white/25"
      >
        <span class={locale === "es" ? "text-white" : "text-white/55"}>ES</span>
        <span class="text-white/30" aria-hidden="true">/</span>
        <span class={locale === "en" ? "text-white" : "text-white/55"}>EN</span>
      </a>

      <button
        type="button"
        id="menu-toggle"
        data-header-item
        aria-label={t.header.menuOpen}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 text-white/70 opacity-0 lg:hidden"
      >
        <svg id="menu-icon-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-icon-close" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden flex-col border-t border-white/10 px-6 py-4 lg:hidden">
    {
      nav.map((item) => (
        <a
          href={item.href}
          data-nav-link
          class="nav-link border-b border-white/5 py-3 text-xs font-medium uppercase tracking-[0.15em] text-white/60 last:border-none hover:text-white"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .header-bg {
    background-color: rgb(5 5 5 / 0.85);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  /* El backdrop-filter sólo se aplica cuando la barra está activa: mantenerlo
     declarado permanentemente obliga al navegador a recalcularlo durante el scroll.

     El prefijo -webkit- NO es histórico: Safari sólo entiende `backdrop-filter`
     sin prefijo desde la versión 18. En Safari 15/16/17 la regla sin prefijo se
     descarta entera, así que el header se quedaba sin desenfoque y el Hero se
     transparentaba a través de la barra. */
  .header-bg.is-active {
    opacity: 1;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .header-bg {
      transition: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from "../scripts/motion";

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  // El fondo del header (.header-bg) es opaco/con blur si se cumple CUALQUIERA de
  // las dos condiciones: se scrolleó pasado el umbral, o el menú móvil está abierto.
  // Antes sólo dependía del scroll — si lo abrías en scrollY:0 (muy común: entrar a
  // la página y tocar el menú antes de scrollear) el header quedaba transparente y
  // el Hero se veía a través del menú desplegado.
  const headerBg = document.querySelector<HTMLElement>(".header-bg");
  let scrolledPastThreshold = false;
  let menuOpen = false;

  const syncHeaderBg = () => {
    headerBg?.classList.toggle("is-active", scrolledPastThreshold || menuOpen);
  };

  const closeMenu = () => {
    if (!menuOpen) return;
    menu?.classList.add("hidden");
    menu?.classList.remove("flex");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    menuOpen = false;
    syncHeaderBg();
  };

  toggle?.addEventListener("click", () => {
    menuOpen = menu?.classList.contains("hidden") ?? false;
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(menuOpen));
    syncHeaderBg();
  });

  document.querySelectorAll<HTMLAnchorElement>('#mobile-menu [data-nav-link]').forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Cerrar el menú móvil apenas el usuario hace un gesto de scroll: si quedaba
  // abierto, se quedaba flotando sobre el contenido que se movía debajo.
  //
  // Se escuchan los GESTOS y no el evento `scroll`: ahora hay scrolls
  // programáticos (el puente de foco y los atajos de sección de groups.ts) que no
  // tienen por qué cerrarlo.
  window.addEventListener("wheel", closeMenu, { passive: true });
  window.addEventListener("touchmove", closeMenu, { passive: true });

  // Familia de entrada: descenso escalonado (logo, nav, botones), tras la cortina de carga.
  const headerItems = [
    document.querySelector<HTMLElement>("[data-header-mark]"),
    ...Array.from(document.querySelectorAll<HTMLElement>("[data-desktop-nav] [data-header-item]")),
    ...Array.from(document.querySelectorAll<HTMLElement>("[data-header-actions] [data-header-item]")),
  ].filter((el): el is HTMLElement => !!el);

  const playHeaderIntro = () => {
    if (prefersReducedMotion()) {
      headerItems.forEach((el) => el.classList.remove("opacity-0"));
      return;
    }
    // Nota: sin clearProps en opacity — los items siguen teniendo la clase Tailwind
    // opacity-0 como estado inicial (fallback sin JS), así que limpiar el inline
    // opacity al terminar haría que el elemento "rebotara" de vuelta a invisible.
    gsap.fromTo(headerItems, { y: -8, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power3.out", stagger: 0.05 });
  };

  if (document.getElementById("preloader")) {
    window.addEventListener("preloader:done", playHeaderIntro, { once: true });
  } else {
    playHeaderIntro();
  }

  // Riel deslizante: reemplaza el cambio de color instantáneo por una barra que
  // se mueve/redimensiona entre links activos (mismo principio FLIP del shuffle de Proyectos).
  const rail = document.getElementById("nav-rail");
  const navEl = rail?.parentElement;

  const moveRailTo = (link: HTMLElement) => {
    if (!rail || !navEl) return;
    const navRect = navEl.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    const x = linkRect.left - navRect.left;

    if (prefersReducedMotion()) {
      gsap.set(rail, { x, width: linkRect.width, opacity: 1 });
    } else {
      gsap.to(rail, { x, width: linkRect.width, opacity: 1, duration: 0.4, ease: "expo.inOut" });
    }
  };

  // Estado activo: lo gobierna groups.ts, que emite `nav:active` con el id de la
  // sección visible (los 4 paneles del túnel ocupan inset:0 a la vez, así que un
  // IntersectionObserver no serviría). Los enlaces que no tienen su propia sección
  // en el nav igual se marcan si su sección pertenece al grupo activo.
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  // Secciones sin enlace propio -> enlace representativo de su grupo.
  const REPR = new Map<string, string>([
    ["faq", "proceso"],
    ["habilidades", "experiencia"],
    ["formacion", "experiencia"],
    ["certificados", "experiencia"],
  ]);

  const setActive = (id: string) => {
    // Se compara el hash y no el href completo: los enlaces del nav llevan la
    // home delante (`/#proyectos`), así que un match literal nunca daría.
    const hash = `#${REPR.get(id) ?? id}`;
    links.forEach((link) => {
      const isActive = link.hash === hash;
      link.classList.toggle("text-white", isActive);
      link.classList.toggle("text-white/50", !isActive);
      if (isActive && link.closest("nav")?.id !== "mobile-menu") {
        moveRailTo(link);
      }
    });
  };

  document.addEventListener("nav:active", (event) => {
    const id = (event as CustomEvent<{ id: string }>).detail?.id;
    if (id) setActive(id);
  });

  // Header bg: se activa por umbral, no con la opacidad atada al scroll.
  // Antes el backdrop-filter estaba aplicado siempre y sólo se animaba la opacidad,
  // así que el navegador recalculaba el desenfoque de todo lo que pasaba por detrás
  // en cada frame de scroll — justo cuando se notaba el tirón. Ahora el blur sólo
  // existe mientras la clase está puesta, y el fundido lo hace una transición CSS.
  if (headerBg) {
    if (prefersReducedMotion()) {
      headerBg.classList.add("is-active");
    } else {
      ScrollTrigger.create({
        trigger: document.body,
        start: "top -60",
        onEnter: () => {
          scrolledPastThreshold = true;
          syncHeaderBg();
        },
        onLeaveBack: () => {
          scrolledPastThreshold = false;
          syncHeaderBg();
        },
      });
    }
  }
</script>
