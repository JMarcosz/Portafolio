---
import { nav } from "../data/site";
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10">
  <div class="header-bg pointer-events-none absolute inset-0 -z-10 bg-bg/85 opacity-0 backdrop-blur"></div>

  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="#inicio" data-header-mark class="text-sm font-bold tracking-tight opacity-0">Jean Marco</a>

    <nav data-desktop-nav class="relative hidden items-center gap-7 md:flex">
      <span
        id="nav-rail"
        class="pointer-events-none absolute bottom-[-1px] h-[2px] rounded-full bg-white opacity-0"
      ></span>
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-nav-link
            data-header-item
            class="nav-link text-[11px] font-medium uppercase tracking-[0.15em] text-white/50 opacity-0 transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div data-header-actions class="flex items-center gap-2">
      <button
        type="button"
        data-header-item
        aria-label="Guardar"
        class="hidden h-8 w-8 items-center justify-center rounded-lg border border-white/10 text-white/60 opacity-0 transition-colors hover:text-white md:flex"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
      </button>

      <button
        type="button"
        id="menu-toggle"
        data-header-item
        aria-label="Abrir menú"
        aria-expanded="false"
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 text-white/70 opacity-0 md:hidden"
      >
        <svg id="menu-icon-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-icon-close" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden flex-col border-t border-white/10 px-6 py-4 md:hidden">
    {
      nav.map((item) => (
        <a
          href={item.href}
          data-nav-link
          class="nav-link border-b border-white/5 py-3 text-xs font-medium uppercase tracking-[0.15em] text-white/60 last:border-none hover:text-white"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from "../scripts/motion";

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  document.querySelectorAll<HTMLAnchorElement>('#mobile-menu [data-nav-link]').forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      menu?.classList.remove("flex");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  // Familia de entrada: descenso escalonado (logo, nav, botones), tras la cortina de carga.
  const headerItems = [
    document.querySelector<HTMLElement>("[data-header-mark]"),
    ...Array.from(document.querySelectorAll<HTMLElement>("[data-desktop-nav] [data-header-item]")),
    ...Array.from(document.querySelectorAll<HTMLElement>("[data-header-actions] [data-header-item]")),
  ].filter((el): el is HTMLElement => !!el);

  const playHeaderIntro = () => {
    if (prefersReducedMotion()) {
      headerItems.forEach((el) => el.classList.remove("opacity-0"));
      return;
    }
    // Nota: sin clearProps en opacity — los items siguen teniendo la clase Tailwind
    // opacity-0 como estado inicial (fallback sin JS), así que limpiar el inline
    // opacity al terminar haría que el elemento "rebotara" de vuelta a invisible.
    gsap.fromTo(headerItems, { y: -8, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power3.out", stagger: 0.05 });
  };

  if (document.getElementById("preloader")) {
    window.addEventListener("preloader:done", playHeaderIntro, { once: true });
  } else {
    playHeaderIntro();
  }

  // Riel deslizante: reemplaza el cambio de color instantáneo por una barra que
  // se mueve/redimensiona entre links activos (mismo principio FLIP del shuffle de Proyectos).
  const rail = document.getElementById("nav-rail");
  const navEl = rail?.parentElement;

  const moveRailTo = (link: HTMLElement) => {
    if (!rail || !navEl) return;
    const navRect = navEl.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    const x = linkRect.left - navRect.left;

    if (prefersReducedMotion()) {
      gsap.set(rail, { x, width: linkRect.width, opacity: 1 });
    } else {
      gsap.to(rail, { x, width: linkRect.width, opacity: 1, duration: 0.4, ease: "expo.inOut" });
    }
  };

  // Scroll-spy: resalta el link de la sección visible
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sections = Array.from(links)
    .map((link) => document.querySelector(link.getAttribute("href") || ""))
    .filter((el): el is Element => !!el);

  const setActive = (id: string) => {
    links.forEach((link) => {
      const isActive = link.getAttribute("href") === `#${id}`;
      link.classList.toggle("text-white", isActive);
      link.classList.toggle("text-white/50", !isActive);
      if (isActive && link.closest("nav")?.id !== "mobile-menu") {
        moveRailTo(link);
      }
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
  );

  sections.forEach((section) => observer.observe(section));

  // Header bg: opacidad atada al scroll durante los primeros 400px.
  const headerBg = document.querySelector<HTMLElement>(".header-bg");
  if (headerBg) {
    if (prefersReducedMotion()) {
      gsap.set(headerBg, { opacity: 0.85 });
    } else {
      gsap.to(headerBg, {
        opacity: 0.85,
        ease: "none",
        scrollTrigger: { trigger: document.body, start: "top top", end: "400px top", scrub: true },
      });
    }
  }
</script>
