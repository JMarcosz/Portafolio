---
import { getContent } from "../i18n";
const { footer } = getContent(Astro.currentLocale);
---

<footer data-footer class="border-t border-white/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-bold tracking-tight">{footer.name.toUpperCase()}</p>
      <p class="text-xs text-white/55">{footer.role}</p>
    </div>
    <a href="#contacto" class="text-sm text-white/60 hover:text-white">{footer.contact}</a>
  </div>
  <div class="border-t border-white/5">
    <div class="mx-auto max-w-6xl px-6 py-4 text-[11px] text-white/55">
      © {footer.year} Ing. {footer.name}. {footer.rights}
    </div>
  </div>
</footer>

<script>
  import { gsap, prefersReducedMotion } from "../scripts/motion";

  const el = document.querySelector<HTMLElement>("[data-footer]");
  if (el && !prefersReducedMotion()) {
    gsap.set(el, { autoAlpha: 0, y: 16 });
    gsap.to(el, {
      autoAlpha: 1,
      y: 0,
      duration: 0.7,
      ease: "power2.out",
      scrollTrigger: { trigger: el, start: "top 92%", once: true },
    });
  }
</script>
