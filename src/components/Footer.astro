---
import { footer } from "../data/site";
---

<footer class="border-t border-white/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-bold tracking-tight">{footer.name.toUpperCase()}</p>
      <p class="text-xs text-white/40">{footer.role}</p>
    </div>
    <a href="#contacto" class="text-sm text-white/60 hover:text-white">Contacto</a>
  </div>
  <div class="border-t border-white/5">
    <div class="mx-auto max-w-6xl px-6 py-4 text-[11px] text-white/30">
      © {footer.year} Ing. {footer.name}. Todos los derechos reservados.
    </div>
  </div>
</footer>
