---
import { getContent } from "../i18n";
const { projects: p } = getContent(Astro.currentLocale);
const items = p.items;
---

<section id="proyectos" aria-labelledby="proyectos-title" class="mx-auto max-w-6xl section-y px-6">
  <p class="eyebrow mb-4">{p.eyebrow}</p>
  <h2 id="proyectos-title" class="text-4xl font-bold tracking-tight">
    {p.heading1} <span class="font-extrabold">{p.heading2}</span>
  </h2>

  <div data-projects-grid class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      items.map((project) => (
        <article data-project-card class="card flex flex-col overflow-hidden">
          {/* La media es el gancho: insinúa el sistema en uso. El detalle vive en
              el caso de estudio, no acá. */}
          {/* `tabindex="-1"` pero SIN aria-hidden: el enlace no necesita parada
              propia de teclado (el título de abajo va al mismo sitio), pero la
              captura sí es contenido — es la única prueba visual del proyecto y
              vale como resultado en Google Imágenes. */}
          <a href={project.href} tabindex="-1" class="block overflow-hidden">
            <img
              data-project-img
              src={project.thumb}
              alt={`${project.title} — ${project.valueLine}`}
              width="1200"
              height="675"
              class="aspect-video w-full border-b border-white/10 object-cover object-top"
              loading="lazy"
              decoding="async"
            />
          </a>

          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <p class="eyebrow mb-3">{project.badge}</p>
              <h3 class="text-lg font-semibold">
                <a href={project.href} class="transition-colors hover:text-white/80">
                  {project.title}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-white/50">{project.valueLine}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="rounded-md bg-white/5 px-2 py-1 text-[11px] text-white/60">{tag}</span>
                ))}
              </div>
            </div>

            {/* CTA principal a ancho completo: en una fila junto a "Ver demo" el
                texto más largo ("Ver caso de estudio" / "View case study") se
                partía en dos líneas dentro del pill en pantallas angostas. */}
            <div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-5">
              <a href={project.href} data-magnetic data-case-link class="btn-primary w-full justify-center text-sm">
                {p.viewCase}
                <svg data-case-arrow width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>

              <div class="flex items-center gap-3">
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-demo-link
                  class="inline-flex flex-1 items-center justify-center gap-2 rounded-full border border-white/15 px-4 py-2 text-sm font-medium text-white/80 transition-colors hover:border-white/30 hover:text-white"
                >
                  {p.viewDemo}
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17L17 7M17 7H9M17 7v8" />
                  </svg>
                </a>
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-code-link
                  aria-label={`${p.viewCodeAria} ${project.title}`}
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-white/60 transition-colors hover:border-white/30 hover:text-white"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 3L4 12l4 9M16 3l4 9-4 9" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap, hasFinePointer, floatIdle, prefersReducedMotion, TOKENS } from "../scripts/motion";
  import { registerSection } from "../scripts/stage";

  const cards = gsap.utils.toArray<HTMLElement>("[data-project-card]");
  const grid = document.querySelector<HTMLElement>("[data-projects-grid]");

  // La perspectiva sólo hace falta mientras el tilt 3D puede activarse.
  if (grid && hasFinePointer() && !prefersReducedMotion()) {
    grid.style.perspective = "900px";
  }

  // Familia de entrada: profundidad ascendente — scale + translateY a la vez.
  registerSection("proyectos", {
    prepare: () => gsap.set(cards, { autoAlpha: 0, y: 30, scale: 0.92 }),
    reveal: () =>
      gsap
        .timeline({ onComplete: () => cards.forEach((card) => floatIdle(card, 2.5)) })
        .to(cards, { autoAlpha: 1, y: 0, scale: 1, stagger: TOKENS.stagger.normal, force3D: true, ...TOKENS.revealMd }),
    settle: () => gsap.set(cards, { autoAlpha: 1, y: 0, scale: 1 }),
  });

  cards.forEach((card) => {
    const img = card.querySelector<HTMLElement>("[data-project-img]");
    const codeLink = card.querySelector<HTMLElement>("[data-code-link]");

    if (hasFinePointer() && !prefersReducedMotion()) {
      // quickTo, no gsap.to: un `gsap.to` por evento instanciaba DOS tweens
      // nuevos en cada movimiento del ratón — a 120 Hz son ~240 tweens por
      // segundo creados, resueltos por overwrite y descartados. quickTo reusa
      // uno solo, que es lo que ya hacían los CTAs de esta misma sección.
      const tiltY = gsap.quickTo(card, "rotateY", { duration: 0.4, ease: "power2.out" });
      const tiltX = gsap.quickTo(card, "rotateX", { duration: 0.4, ease: "power2.out" });

      // El rect se cachea al entrar: pedirlo por movimiento era una lectura de
      // layout por evento, y la tarjeta no cambia de tamaño mientras el cursor
      // está encima.
      let rect: DOMRect | null = null;

      card.addEventListener("mouseenter", () => {
        rect = card.getBoundingClientRect();
        gsap.to(img, { scale: 1.06, duration: 0.5, ease: "power2.out" });
      });
      card.addEventListener("mousemove", (event) => {
        if (!rect) rect = card.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width - 0.5;
        const py = (event.clientY - rect.top) / rect.height - 0.5;
        tiltY(px * 6);
        tiltX(py * -6);
      });
      card.addEventListener("mouseleave", () => {
        rect = null;
        tiltY(0);
        tiltX(0);
        gsap.to(img, { scale: 1, duration: 0.5, ease: "power2.out" });
      });
      codeLink?.addEventListener("mouseenter", () => {
        gsap.to(codeLink, { rotate: 8, duration: 0.3, ease: "back.out(1.7)" });
      });
      codeLink?.addEventListener("mouseleave", () => {
        gsap.to(codeLink, { rotate: 0, duration: 0.3, ease: "power2.out" });
      });
    }
  });

  // CTA "Ver caso de estudio" magnético + flecha que avanza.
  if (hasFinePointer() && !prefersReducedMotion()) {
    document.querySelectorAll<HTMLElement>("[data-case-link]").forEach((link) => {
      const arrow = link.querySelector<HTMLElement>("[data-case-arrow]");
      const moveX = gsap.quickTo(link, "x", { duration: 0.4, ease: "power3" });
      const moveY = gsap.quickTo(link, "y", { duration: 0.4, ease: "power3" });

      link.addEventListener("mousemove", (event) => {
        const rect = link.getBoundingClientRect();
        moveX((event.clientX - rect.left - rect.width / 2) * 0.25);
        moveY((event.clientY - rect.top - rect.height / 2) * 0.25);
        gsap.to(arrow, { x: 3, duration: 0.3 });
      });
      link.addEventListener("mouseleave", () => {
        moveX(0);
        moveY(0);
        gsap.to(arrow, { x: 0, duration: 0.3 });
      });
    });

    // "Ver demo" repite la flecha diagonal — mismo lenguaje que el CTA
    // principal, para que quede claro que también abre algo, no navega la página.
    document.querySelectorAll<HTMLElement>("[data-demo-link]").forEach((link) => {
      const arrow = link.querySelector("svg");
      link.addEventListener("mouseenter", () => gsap.to(arrow, { x: 2, y: -2, duration: 0.3 }));
      link.addEventListener("mouseleave", () => gsap.to(arrow, { x: 0, y: 0, duration: 0.3 }));
    });
  }
</script>
