---
import { getContent } from "../i18n";
const { projects: p } = getContent(Astro.currentLocale);
const items = p.items;
---

<section id="proyectos" aria-labelledby="proyectos-title" class="mx-auto max-w-6xl section-y px-6">
  <p class="eyebrow mb-4">{p.eyebrow}</p>
  <h2 id="proyectos-title" class="text-4xl font-bold tracking-tight">
    {p.heading1} <span class="font-extrabold">{p.heading2}</span>
  </h2>

  <div data-projects-grid class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      items.map((project) => (
        <article data-project-card class="card flex flex-col overflow-hidden">
          {/* La media es el gancho: insinúa el sistema en uso. El detalle vive en
              el caso de estudio, no acá. */}
          <a href={project.href} tabindex="-1" aria-hidden="true" class="block overflow-hidden">
            <img
              data-project-img
              src={project.image}
              alt=""
              class="aspect-video w-full border-b border-white/10 object-cover object-top"
              loading="lazy"
            />
          </a>

          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <p class="eyebrow mb-3">{project.badge}</p>
              <h3 class="text-lg font-semibold">
                <a href={project.href} class="transition-colors hover:text-white/80">
                  {project.title}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-white/50">{project.valueLine}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="rounded-md bg-white/5 px-2 py-1 text-[11px] text-white/60">{tag}</span>
                ))}
              </div>
            </div>

            <div class="mt-6 flex items-center gap-4 border-t border-white/10 pt-5">
              <a href={project.href} data-magnetic data-case-link class="btn-primary flex-1 justify-center text-sm">
                {p.viewCase}
                <svg data-case-arrow width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 text-sm text-white/55 underline-offset-4 transition-colors hover:text-white hover:underline"
              >
                {p.viewDemo}
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap, hasFinePointer, floatIdle, prefersReducedMotion, TOKENS } from "../scripts/motion";
  import { registerSection } from "../scripts/stage";

  const cards = gsap.utils.toArray<HTMLElement>("[data-project-card]");
  const grid = document.querySelector<HTMLElement>("[data-projects-grid]");

  // La perspectiva sólo hace falta mientras el tilt 3D puede activarse.
  if (grid && hasFinePointer() && !prefersReducedMotion()) {
    grid.style.perspective = "900px";
  }

  // Familia de entrada: profundidad ascendente — scale + translateY a la vez.
  registerSection("proyectos", {
    prepare: () => gsap.set(cards, { autoAlpha: 0, y: 30, scale: 0.92 }),
    reveal: () =>
      gsap
        .timeline({ onComplete: () => cards.forEach((card) => floatIdle(card, 2.5)) })
        .to(cards, { autoAlpha: 1, y: 0, scale: 1, stagger: TOKENS.stagger.normal, force3D: true, ...TOKENS.revealMd }),
    settle: () => gsap.set(cards, { autoAlpha: 1, y: 0, scale: 1 }),
  });

  cards.forEach((card) => {
    const img = card.querySelector<HTMLElement>("[data-project-img]");

    if (hasFinePointer() && !prefersReducedMotion()) {
      card.addEventListener("mousemove", (event) => {
        const rect = card.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width - 0.5;
        const py = (event.clientY - rect.top) / rect.height - 0.5;
        gsap.to(card, { rotateY: px * 6, rotateX: py * -6, duration: 0.4, ease: "power2.out" });
        gsap.to(img, { scale: 1.06, duration: 0.5, ease: "power2.out" });
      });
      card.addEventListener("mouseleave", () => {
        gsap.to(card, { rotateY: 0, rotateX: 0, duration: 0.5, ease: "power2.out" });
        gsap.to(img, { scale: 1, duration: 0.5, ease: "power2.out" });
      });
    }
  });

  // CTA "Ver caso de estudio" magnético + flecha que avanza.
  if (hasFinePointer() && !prefersReducedMotion()) {
    document.querySelectorAll<HTMLElement>("[data-case-link]").forEach((link) => {
      const arrow = link.querySelector<HTMLElement>("[data-case-arrow]");
      const moveX = gsap.quickTo(link, "x", { duration: 0.4, ease: "power3" });
      const moveY = gsap.quickTo(link, "y", { duration: 0.4, ease: "power3" });

      link.addEventListener("mousemove", (event) => {
        const rect = link.getBoundingClientRect();
        moveX((event.clientX - rect.left - rect.width / 2) * 0.25);
        moveY((event.clientY - rect.top - rect.height / 2) * 0.25);
        gsap.to(arrow, { x: 3, duration: 0.3 });
      });
      link.addEventListener("mouseleave", () => {
        moveX(0);
        moveY(0);
        gsap.to(arrow, { x: 0, duration: 0.3 });
      });
    });
  }
</script>
