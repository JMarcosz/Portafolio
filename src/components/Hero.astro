---
import { getContent } from "../i18n";
const { hero, schedule } = getContent(Astro.currentLocale);
---

<section
  id="inicio"
  aria-labelledby="inicio-title"
  class="relative flex min-h-[calc(100dvh-var(--group-top))] items-center overflow-x-clip"
  data-hero-section
>
  <!-- Capa densa de partículas solo para el Hero (se va con el grupo al hacer zoom). -->
  <canvas data-hero-particles class="pointer-events-none fixed inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>

  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-10 px-6 py-12 sm:py-16 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="eyebrow mb-4" data-hero-eyebrow>{hero.eyebrow}</p>
      <!-- aria-label lleva el nombre completo + rol para SEO/lectores de pantalla. -->
      <h1 id="inicio-title"
        aria-label={hero.nameAria}
        class="text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl"
      >
        <span class="block overflow-hidden">
          <span class="block text-white/90" data-hero-line1>{hero.title1}</span>
        </span>
        <span class="block overflow-hidden">
          <span class="block" data-hero-line2>{hero.title2}</span>
        </span>
      </h1>
      <p class="mt-6 max-w-md text-sm leading-relaxed text-white/50" data-hero-paragraph>
        {hero.description}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={schedule}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          data-hero-cta
        >
          {hero.cta}
        </a>
        <a
          href={encodeURI(hero.cvFile)}
          target="_blank"
          rel="noopener noreferrer"
          data-hero-cta
          class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white/80 transition-colors hover:border-white/30 hover:text-white"
        >
          {hero.cvLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6M9 15h6M9 11h2" />
          </svg>
        </a>
      </div>
    </div>

    <div class="relative flex items-center justify-center" data-hero-visual>
      <div
        class="relative h-56 w-56 overflow-hidden rounded-full border border-white/10 sm:h-72 sm:w-72 lg:h-96 lg:w-96"
        data-hero-circle
      >
        <img src={hero.photo} alt={hero.photoAlt} class="h-full w-full object-cover object-top" />
      </div>
    </div>
  </div>

  <button
    type="button"
    data-scroll-cue
    class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-[10px] uppercase tracking-[0.2em] text-white/55 transition-colors hover:text-white/60"
    aria-label={hero.scrollAria}
  >
    <span>{hero.scroll}</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14M5 12l7 7 7-7"></path>
    </svg>
  </button>
</section>

<script>
  import { gsap, hasFinePointer, prefersReducedMotion } from "../scripts/motion";
  import { initParticleField } from "../scripts/particle-field";

  // Capa densa propia del Hero. El fondo global (Layout) va disperso; esta solo
  // se dibuja mientras el Hero está en pantalla.
  const heroCanvas = document.querySelector<HTMLCanvasElement>("[data-hero-particles]");
  if (heroCanvas) {
    initParticleField(heroCanvas, {
      count: 210,
      visible: () => window.scrollY < window.innerHeight * 1.6,
    });
  }

  const eyebrow = document.querySelector<HTMLElement>("[data-hero-eyebrow]");
  const line1 = document.querySelector<HTMLElement>("[data-hero-line1]");
  const line2 = document.querySelector<HTMLElement>("[data-hero-line2]");
  const paragraph = document.querySelector<HTMLElement>("[data-hero-paragraph]");
  const ctas = document.querySelectorAll<HTMLElement>("[data-hero-cta]");
  const circle = document.querySelector<HTMLElement>("[data-hero-circle]");
  const scrollCue = document.querySelector<HTMLElement>("[data-scroll-cue]");

  // El estado oculto se aplica YA, de forma sincrónica, no cuando el preloader termina.
  // Si se aplicara recién en playHeroIntro(), la cortina abriría sobre un Hero todavía
  // visible en su estado final (nadie lo ocultó aún) y recién ahí saltaría a oculto
  // para animar — el "aparece y desaparece" que se ve como bug. Ocultarlo de entrada
  // hace que la cortina siempre abra sobre el Hero ya en su punto de partida.
  if (!prefersReducedMotion()) {
    gsap.set([line1, line2], { yPercent: 115 });
    gsap.set(paragraph, { yPercent: 105, autoAlpha: 0 });
    gsap.set([eyebrow, circle], { autoAlpha: 0 });
    gsap.set(ctas, { autoAlpha: 0, scale: 0.9 });
    gsap.set(circle, { scale: 0.92 });
  }

  const playHeroIntro = () => {
    if (prefersReducedMotion()) return;

    gsap
      .timeline({ defaults: { ease: "expo.out" } })
      .to(eyebrow, { autoAlpha: 1, duration: 0.5 })
      .to(line1, { yPercent: 0, duration: 1 }, "<0.05")
      .to(line2, { yPercent: 0, duration: 1 }, "<0.15")
      .to(paragraph, { yPercent: 0, autoAlpha: 1, duration: 0.85 }, "-=0.6")
      .to(ctas, { autoAlpha: 1, scale: 1, duration: 0.5, stagger: 0.08, ease: "back.out(1.4)" }, "-=0.3")
      .to(circle, { autoAlpha: 1, scale: 1, duration: 0.7 }, "-=0.4");
  };

  if (document.getElementById("preloader")) {
    window.addEventListener("preloader:done", playHeroIntro, { once: true });
  } else {
    playHeroIntro();
  }

  // La salida inmersiva del Hero (zoom hacia la cámara) la maneja el túnel de
  // grupos (groups.ts) en la transición hacia el grupo siguiente.

  // Botón magnético en la foto: sigue el cursor con inercia (gsap.quickTo), no en teletransporte.
  const heroSection = document.querySelector<HTMLElement>("[data-hero-section]");

  if (heroSection && circle && hasFinePointer() && !prefersReducedMotion()) {
    const moveCircle = gsap.quickTo(circle, "x", { duration: 0.6, ease: "power3" });
    const moveCircleY = gsap.quickTo(circle, "y", { duration: 0.6, ease: "power3" });

    heroSection.addEventListener("mousemove", (event) => {
      const rect = heroSection.getBoundingClientRect();
      const px = (event.clientX - rect.left) / rect.width; // 0..1 sobre TODO el hero
      const py = (event.clientY - rect.top) / rect.height;

      moveCircle((px - 0.5) * 20);
      moveCircleY((py - 0.5) * 20);
    });

    heroSection.addEventListener("mouseleave", () => {
      moveCircle(0);
      moveCircleY(0);
    });
  }

  // Indicador de scroll: se desvanece tras el primer scroll del usuario.
  if (scrollCue) {
    let dismissed = false;
    const dismiss = () => {
      if (dismissed) return;
      dismissed = true;
      if (prefersReducedMotion()) {
        scrollCue.style.opacity = "0";
      } else {
        gsap.to(scrollCue, { autoAlpha: 0, duration: 0.4 });
      }
      window.removeEventListener("scroll", dismiss);
    };
    window.addEventListener("scroll", dismiss, { passive: true });
    scrollCue.addEventListener("click", () => {
      // Reutiliza el enlace del nav para que el scroll pase por Lenis (smooth-scroll.ts).
      const link = document.querySelector<HTMLElement>('[data-nav-link][href="#sobre-mi"]');
      if (link) link.click();
      else document.getElementById("sobre-mi")?.scrollIntoView({ behavior: "smooth" });
    });
  }
</script>
