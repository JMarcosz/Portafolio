---
import { getContent } from "../i18n";
const { contact, socials, schedule } = getContent(Astro.currentLocale);

const filledIcons = new Set(["linkedin", "whatsapp"]);
const iconPaths: Record<string, string> = {
  linkedin:
    '<path d="M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM7 8.48H3V21h4V8.48zM13.5 8.48h-3.83V21h3.83v-6.37c0-1.68.32-3.3 2.4-3.3 2.05 0 2.08 1.92 2.08 3.4V21H22v-7.18c0-3.47-.75-6.14-4.8-6.14-1.95 0-3.25 1.07-3.79 2.08h-.05V8.48h.14z"/>',
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  whatsapp:
    '<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.71 14.02c-.24.68-1.19 1.24-1.95 1.4-.52.11-1.2.2-3.49-.75-2.93-1.21-4.82-4.19-4.97-4.39-.14-.19-1.18-1.57-1.18-3 0-1.43.75-2.13 1.02-2.42.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.83 2 .9 2.14.07.14.11.31.02.5-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.07.16-.19.68-.79.87-1.06.19-.27.37-.22.62-.13.26.09 1.63.77 1.91.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/>',
  email: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>',
};
---

<section id="contacto" aria-labelledby="contacto-title" class="mx-auto max-w-6xl section-y px-6">
  <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
    <div>
      <p data-focus-item class="eyebrow mb-4">{contact.eyebrow}</p>
      <h2 id="contacto-title" data-focus-item class="text-4xl font-bold tracking-tight">
        <span class="block text-white/90">{contact.title1}</span>
        <span class="block font-extrabold">{contact.title2}</span>
      </h2>
      <p data-focus-item class="mt-6 max-w-sm text-sm leading-relaxed text-white/50">{contact.description}</p>

      <!-- Mismo CTA que el hero: si el visitante llegó hasta acá convencido, no
           debería tener que decidir otra vez por dónde escribir. -->
      <div data-focus-item class="mt-8 flex flex-wrap items-center gap-4">
        <a href={schedule} target="_blank" rel="noopener noreferrer" data-magnetic class="btn-primary">
          {contact.scheduleCta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <span class="text-xs text-white/45">{contact.orForm}</span>
      </div>

      <dl data-focus-item class="mt-10 space-y-3 text-sm">
        <div class="flex gap-3">
          <dt class="w-24 shrink-0 text-[11px] uppercase tracking-wider text-white/55">{contact.fieldEmail}</dt>
          <dd>
            <a href={`mailto:${contact.email}`} class="text-white/80 hover:text-white">{contact.email}</a>
          </dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-24 shrink-0 text-[11px] uppercase tracking-wider text-white/55">{contact.fieldLocation}</dt>
          <dd class="text-white/80">{contact.location}</dd>
        </div>
      </dl>

      <div data-focus-item class="mt-8 flex gap-3">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              data-social-btn
              class="relative flex h-10 w-10 items-center justify-center overflow-hidden rounded-full border border-white/10 text-white/60 transition-colors"
            >
              <span data-social-fill class="absolute inset-0 origin-bottom scale-y-0 rounded-full bg-white" />
              <svg
                data-social-icon
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill={filledIcons.has(social.icon) ? "currentColor" : "none"}
                stroke={filledIcons.has(social.icon) ? "none" : "currentColor"}
                stroke-width={filledIcons.has(social.icon) ? undefined : "2"}
                class="relative"
                set:html={iconPaths[social.icon]}
              />
            </a>
          ))
        }
      </div>
    </div>

    <form
      id="contact-form"
      class="space-y-5"
      data-msg-submit={contact.submit}
      data-msg-sending={contact.sending}
      data-msg-sent={contact.sent}
      data-msg-ok={contact.okMsg}
      data-msg-err={contact.errMsg}
      data-msg-conn={contact.connErr}
      data-msg-noconf={contact.notConfigured}
    >
      <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ""} />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

      <div data-focus-item class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="mb-2 block text-[11px] uppercase tracking-wider text-white/55">{contact.labelName}</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            placeholder={contact.phName}
            class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-white/55 focus:border-white/30"
          />
        </div>
        <div>
          <label for="email" class="mb-2 block text-[11px] uppercase tracking-wider text-white/55">{contact.labelEmail}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder={contact.phEmail}
            class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-white/55 focus:border-white/30"
          />
        </div>
      </div>

      <div data-focus-item>
        <label for="message" class="mb-2 block text-[11px] uppercase tracking-wider text-white/55">{contact.labelMessage}</label>
        <textarea
          id="message"
          name="message"
          required
          rows="4"
          placeholder={contact.phMessage}
          class="w-full resize-none rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-white/55 focus:border-white/30"
        ></textarea>
      </div>

      <button type="submit" id="contact-submit" data-focus-item data-magnetic class="btn-primary">
        <span data-submit-label>{contact.submit}</span>
        <svg data-submit-arrow width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
        <svg
          data-submit-check
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          style="display: none;"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </button>

      <p id="contact-status" class="hidden text-xs" role="status"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
  const submitLabel = submitBtn?.querySelector("[data-submit-label]");
  const submitArrow = document.querySelector<HTMLElement>("[data-submit-arrow]");
  const submitCheck = document.querySelector<HTMLElement>("[data-submit-check]");

  const msg = (k: string) => form?.getAttribute(`data-msg-${k}`) || "";

  const setStatus = (message: string, tone: "error" | "success") => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("hidden", "text-red-400", "text-emerald-400");
    status.classList.add(tone === "error" ? "text-red-400" : "text-emerald-400");
  };

  const showCheck = async () => {
    const { gsap, prefersReducedMotion } = await import("../scripts/motion");
    if (!submitArrow || !submitCheck) return;
    if (prefersReducedMotion()) {
      submitArrow.style.display = "none";
      submitCheck.style.display = "";
      return;
    }
    gsap.to(submitArrow, {
      autoAlpha: 0,
      scale: 0.6,
      duration: 0.2,
      onComplete: () => {
        submitArrow.style.display = "none";
        submitCheck.style.display = "";
        gsap.fromTo(submitCheck, { autoAlpha: 0, scale: 0.6 }, { autoAlpha: 1, scale: 1, duration: 0.3, ease: "back.out(1.7)" });
      },
    });
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!submitBtn || !submitLabel) return;

    const accessKey = (form.elements.namedItem("access_key") as HTMLInputElement)?.value;
    if (!accessKey) {
      setStatus(msg("noconf"), "error");
      return;
    }

    submitBtn.disabled = true;
    const originalLabel = submitLabel.textContent;
    submitLabel.textContent = msg("sending");

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json();

      if (result.success) {
        setStatus(msg("ok"), "success");
        submitLabel.textContent = msg("sent");
        await showCheck();
        form.reset();
      } else {
        setStatus(msg("err"), "error");
        submitLabel.textContent = originalLabel;
      }
    } catch {
      setStatus(msg("conn"), "error");
      submitLabel.textContent = originalLabel;
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<script>
  import { gsap, hasFinePointer, prefersReducedMotion, TOKENS } from "../scripts/motion";
  import { registerSection } from "../scripts/stage";

  // Familia de entrada: enfoque de cámara — blur + scale en vez de traslación.
  const focusItems = gsap.utils.toArray<HTMLElement>("#contacto [data-focus-item]");
  const socialBtns = gsap.utils.toArray<HTMLElement>("[data-social-btn]");

  // Animar `filter: blur()` es de lo más caro que hay en mobile, así que ahí se
  // usa sólo el scale — que ya lee como "enfoque" — y en desktop un radio chico.
  const useBlur = hasFinePointer();

  registerSection("contacto", {
    prepare: () => {
      gsap.set(focusItems, { autoAlpha: 0, scale: 1.03, ...(useBlur ? { filter: "blur(3px)" } : {}) });
      gsap.set(socialBtns, { autoAlpha: 0, scale: 0.7 });
    },
    reveal: () =>
      gsap
        .timeline()
        .to(
          focusItems,
          {
            autoAlpha: 1,
            scale: 1,
            ...(useBlur ? { filter: "blur(0px)" } : {}),
            stagger: TOKENS.stagger.tight,
            ...TOKENS.revealMd,
          },
          0
        )
        .to(socialBtns, { autoAlpha: 1, scale: 1, stagger: TOKENS.stagger.tight, ...TOKENS.bounce }, "-=0.4"),
    settle: () => {
      gsap.set(focusItems, { clearProps: "all" });
      gsap.set(socialBtns, { clearProps: "all" });
    },
  });

  // Botones sociales: relleno que sube desde abajo + ícono que gira, al hover.
  if (hasFinePointer() && !prefersReducedMotion()) {
    socialBtns.forEach((btn) => {
      const fill = btn.querySelector<HTMLElement>("[data-social-fill]");
      const icon = btn.querySelector<HTMLElement>("[data-social-icon]");
      btn.addEventListener("mouseenter", () => {
        gsap.to(fill, { scaleY: 1, duration: 0.35, ease: "power2.out" });
        gsap.to(icon, { color: "#000000", rotate: 8, duration: 0.35, ease: "power2.out" });
      });
      btn.addEventListener("mouseleave", () => {
        gsap.to(fill, { scaleY: 0, duration: 0.3, ease: "power2.out" });
        gsap.to(icon, { color: "currentColor", rotate: 0, duration: 0.3, ease: "power2.out" });
      });
    });
  }

  // Botón "Enviar mensaje" magnético.
  const submit = document.getElementById("contact-submit");
  if (submit && hasFinePointer() && !prefersReducedMotion()) {
    const moveX = gsap.quickTo(submit, "x", { duration: 0.4, ease: "power3" });
    const moveY = gsap.quickTo(submit, "y", { duration: 0.4, ease: "power3" });
    submit.addEventListener("mousemove", (event) => {
      const rect = submit.getBoundingClientRect();
      moveX((event.clientX - rect.left - rect.width / 2) * 0.25);
      moveY((event.clientY - rect.top - rect.height / 2) * 0.25);
    });
    submit.addEventListener("mouseleave", () => {
      moveX(0);
      moveY(0);
    });
  }
</script>
