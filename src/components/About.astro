---
import { getContent } from "../i18n";
const { about } = getContent(Astro.currentLocale);
---

<section id="sobre-mi" aria-labelledby="sobre-mi-title" class="mx-auto max-w-6xl section-y px-6">
  <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
    <div>
      <p class="eyebrow mb-4">{about.eyebrow}</p>
      <h2 id="sobre-mi-title" data-about-heading class="text-4xl font-bold tracking-tight">
        <span class="block text-white/90">{about.title1}</span>
        <span class="block font-extrabold">{about.title2}</span>
      </h2>
    </div>

    <div data-about-copy class="space-y-4 text-sm leading-relaxed text-white/50">
      {about.paragraphs.map((p) => <p>{p}</p>)}
      <p>
        {about.highlightIntro}<span data-about-highlight class="font-semibold text-white">{about.highlight}</span>{about.paragraphAfterHighlight}
      </p>
    </div>
  </div>

  <div class="mt-16 grid grid-cols-2 gap-8 border-t border-white/10 pt-10 md:grid-cols-4">
    {
      about.stats.map((stat) => {
        // Sólo los valores que empiezan por dígito llevan contador. Los que no
        // ("ES/EN") se pintan tal cual: con el contador se quedaban clavados en
        // "0", porque el parseo no tenía de dónde sacar un número al que subir.
        const match = stat.value.match(/^(\d+)(.*)$/);
        return (
          <div data-stat>
            {match ? (
              <p class="text-3xl font-bold tracking-tight" data-stat-value data-target={match[1]} data-suffix={match[2]}>
                0{match[2]}
              </p>
            ) : (
              <p class="text-3xl font-bold tracking-tight">{stat.value}</p>
            )}
            <p class="mt-1 text-[11px] uppercase tracking-wider text-white/55">{stat.label}</p>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  import { gsap, SplitText, TOKENS } from "../scripts/motion";
  import { registerSection } from "../scripts/stage";

  const heading = document.querySelector<HTMLElement>("[data-about-heading]");
  const copy = document.querySelector<HTMLElement>("[data-about-copy]");
  const statValues = gsap.utils.toArray<HTMLElement>("[data-stat-value]");

  // SplitText reconstruye el interior de los <p> al partirlos en líneas, así que
  // el highlight hay que re-consultarlo DESPUÉS de partir: una referencia tomada
  // antes apunta a un nodo huérfano, ya desprendido del documento.
  const findHighlight = () => document.querySelector<HTMLElement>("[data-about-highlight]");

  let headingLines: Element[] = [];
  let copyLines: Element[] = [];

  // Contadores: de 0 al valor real, con arranque escalonado. Van DENTRO del
  // timeline de entrada — antes eran un scrub aparte y se desincronizaban del
  // texto que los acompaña.
  const addCounters = (tl: gsap.core.Timeline) => {
    statValues.forEach((el, i) => {
      const target = parseInt(el.dataset.target || "0", 10);
      const suffix = el.dataset.suffix || "";
      const counter = { val: 0 };
      tl.to(
        counter,
        {
          val: target,
          duration: 1.1,
          ease: "power3.out",
          onUpdate: () => {
            el.textContent = Math.round(counter.val) + suffix;
          },
        },
        0.15 + i * TOKENS.stagger.normal
      );
    });
  };

  registerSection("sobre-mi", {
    prepare: () => {
      if (heading && copy) {
        headingLines = new SplitText(heading, { type: "lines", mask: "lines", aria: "none" }).lines;
        copyLines = new SplitText(copy.querySelectorAll("p"), { type: "lines", mask: "lines", aria: "none" }).lines;
        gsap.set([...headingLines, ...copyLines], { yPercent: 105 });
      }
      const highlight = findHighlight();
      if (highlight) {
        gsap.set(highlight, {
          backgroundImage: "linear-gradient(currentColor, currentColor)",
          backgroundRepeat: "no-repeat",
          backgroundPosition: "0 100%",
          backgroundSize: "0% 2px",
        });
      }
    },
    reveal: () => {
      const highlight = findHighlight();
      const tl = gsap.timeline();
      tl.to(headingLines, { yPercent: 0, ...TOKENS.splitLine }, 0).to(copyLines, { yPercent: 0, ...TOKENS.splitLine }, 0.2);
      if (highlight) tl.to(highlight, { backgroundSize: "100% 2px", ...TOKENS.revealSm }, 0.5);
      addCounters(tl);
      return tl;
    },
    settle: () => {
      const highlight = findHighlight();
      if (highlight) highlight.style.textDecoration = "underline";
      statValues.forEach((el) => {
        el.textContent = (el.dataset.target || "0") + (el.dataset.suffix || "");
      });
    },
  });
</script>
