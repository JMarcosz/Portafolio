---
import { getContent } from "../i18n";
const { certificates: certs } = getContent(Astro.currentLocale);
const certificates = certs.items;
---

<section id="certificados" class="mx-auto max-w-6xl px-6 py-24">
  <p class="eyebrow mb-4 text-center">{certs.eyebrow}</p>
  <h2 class="text-center text-4xl font-bold tracking-tight">
    {certs.heading1} <span class="font-extrabold">{certs.heading2}</span>
  </h2>

  <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      certificates.map((cert) => (
        <article data-cert-card class="card flex flex-col justify-between p-6 transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-white/25">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-white/40">{cert.year}</span>
              <span data-cert-badge class="pill">{certs.verified}</span>
            </div>

            <h3 class="mt-4 text-base font-semibold leading-snug">{cert.title}</h3>
            <p class="mt-1 text-xs text-white/40">{cert.institution}</p>
            <p class="mt-3 text-sm leading-relaxed text-white/50">{cert.description}</p>
          </div>

          <div class="mt-6 flex flex-wrap gap-2 border-t border-white/10 pt-4">
            {cert.tags.map((tag) => (
              <span class="rounded-md bg-white/5 px-2 py-1 text-[11px] text-white/60">{tag}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap, floatIdle, prefersReducedMotion } from "../scripts/motion";
  import { registerPanelScrub } from "../scripts/panel-scrub";

  const cards = gsap.utils.toArray<HTMLElement>("[data-cert-card]");

  if (prefersReducedMotion()) {
    gsap.set(cards, { clipPath: "inset(0 0% 0 0)", autoAlpha: 1 });
  } else {
    // Familia de entrada: persiana — clip-path que se descorre, escalonada.
    gsap.set(cards, { clipPath: "inset(0 100% 0 0)" });

    const tl = gsap.timeline({ paused: true });
    tl.to(cards, { clipPath: "inset(0 0% 0 0)", duration: 0.5, stagger: 0.4, ease: "power3.out" }, 0);
    registerPanelScrub("certificados", (_t, tMax) => tl.progress(tMax));

    // Flotación ambiental en reposo; se pausa en hover para no pelear con la elevación de 4px.
    cards.forEach((card) => {
      const tween = floatIdle(card, 2.5);
      card.addEventListener("mouseenter", () => tween?.pause());
      card.addEventListener("mouseleave", () => tween?.play());
    });
  }
</script>
