---
import { getContent } from "../i18n";
const { experience: exp } = getContent(Astro.currentLocale);
const experience = exp.items;
---

<section id="experiencia" class="mx-auto max-w-6xl px-6 py-24">
  <p class="eyebrow mb-4">{exp.eyebrow}</p>
  <h2 class="text-4xl font-bold tracking-tight">
    {exp.heading1} <span class="font-extrabold">{exp.heading2}</span>
  </h2>

  <div data-timeline class="relative mt-14">
    <div class="absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 bg-white/10 md:block"></div>
    <div
      data-timeline-fill
      class="absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 bg-white md:block"
      style="transform-origin: top; transform: scaleY(0);"
    >
    </div>

    <div class="flex flex-col gap-10">
      {
        experience.map((item, i) => (
          <div class={`relative grid grid-cols-1 md:grid-cols-2 md:gap-x-10 ${i % 2 === 1 ? "" : ""}`}>
            <span data-timeline-dot class="absolute left-1/2 top-8 hidden h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-white opacity-0 md:block" />

            <div data-timeline-card data-side={i % 2 === 0 ? "left" : "right"} class={i % 2 === 0 ? "md:col-start-1" : "md:col-start-2"}>
              <article class="card p-6">
                <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] font-medium uppercase tracking-wider text-white/40">
                  <span class="inline-flex items-center gap-1.5">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" />
                      <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    {item.period}
                  </span>
                </div>

                <h3 class="text-base font-semibold">{item.role}</h3>
                <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-white/50">
                  <span class="inline-flex items-center gap-1.5">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="7" width="20" height="14" rx="2" />
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                    </svg>
                    {item.company}
                  </span>
                  <span class="inline-flex items-center gap-1.5">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                    {item.location}
                  </span>
                </div>

                <ul class="mt-4 space-y-2">
                  {item.bullets.map((bullet) => (
                    <li class="flex gap-2 text-sm leading-relaxed text-white/50">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-white/30" />
                      {bullet}
                    </li>
                  ))}
                </ul>

                <div class="mt-5 flex flex-wrap gap-2 border-t border-white/10 pt-4">
                  {item.tags.map((tag) => (
                    <span class="rounded-md bg-white/5 px-2 py-1 text-[11px] text-white/60">{tag}</span>
                  ))}
                </div>
              </article>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from "../scripts/motion";
  import { registerPanelScrub } from "../scripts/panel-scrub";

  const rail = document.querySelector<HTMLElement>("[data-timeline]");
  const fill = document.querySelector<HTMLElement>("[data-timeline-fill]");
  const dots = gsap.utils.toArray<HTMLElement>("[data-timeline-dot]");
  const cards = gsap.utils.toArray<HTMLElement>("[data-timeline-card]");

  if (prefersReducedMotion()) {
    gsap.set(fill, { scaleY: 1 });
    gsap.set(dots, { autoAlpha: 1 });
    gsap.set(cards, { autoAlpha: 1 });
  } else if (rail && fill) {
    gsap.set(fill, { scaleY: 0, transformOrigin: "top" });
    gsap.set(dots, { autoAlpha: 0, scale: 0.4 });
    cards.forEach((card) => {
      gsap.set(card, { autoAlpha: 0, x: card.dataset.side === "left" ? -60 : 60 });
      gsap.set(card.querySelectorAll("li"), { autoAlpha: 0, y: 8 });
    });

    // Coreografía original: trazo atado 1:1 al scroll + entrada lateral de las
    // tarjetas al cruzar la línea de lectura.
    //
    // ScrollTrigger no sirve para medirla acá: la sección vive dentro del
    // .sticky-stage y su posición real la produce un transform de groups.ts, así
    // que los offsets que ScrollTrigger cachea en el refresh no corresponden con
    // lo que se ve. La cuenta es la misma que hacía el `scrub`, pero leída del
    // rect en vivo dentro del tick del panel.
    const group = rail.closest<HTMLElement>(".scroll-group");
    const clamp01 = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);

    // Equivalente a start "top 60%" / end "bottom 95%": scaleY 0 con el tope del
    // carril en el 60% del viewport, scaleY 1 con su final en el 95%. El original
    // cerraba en "bottom 70%", pero el sub-scroll del grupo termina con el pie de
    // la sección apoyado abajo: con 70% la línea se quedaba en ~0.89 y nunca
    // llegaba a completarse.
    const START = 0.6;
    const END = 0.95;

    // Puntos y tarjetas: disparo único al cruzar su línea, con tweens por tiempo
    // (no scrubeados), tal cual el componente del commit.
    const played = new WeakSet<Element>();

    const revealDot = (dot: HTMLElement) => {
      if (played.has(dot)) return;
      played.add(dot);
      gsap.to(dot, { autoAlpha: 1, scale: 1, duration: 0.4, ease: "back.out(1.7)" });
    };

    // Los bullets se solapan con la entrada de la card en vez de esperar a que
    // termine: arrancan cuando la card va por la mitad, conservando la cascada.
    const revealCard = (card: HTMLElement) => {
      if (played.has(card)) return;
      played.add(card);
      gsap
        .timeline({
          onStart: () => {
            card.style.willChange = "transform, opacity";
          },
          onComplete: () => {
            card.style.willChange = "";
          },
        })
        .to(card, { autoAlpha: 1, x: 0, duration: 0.6, ease: "power3.out", force3D: true })
        .to(card.querySelectorAll("li"), { autoAlpha: 1, y: 0, duration: 0.35, stagger: 0.04, ease: "power2.out" }, "-=0.3");
    };

    registerPanelScrub("experiencia", () => {
      // Durante el zoom entre grupos el grupo entero está escalado: los rects no
      // son medibles. Se congela lo ya dibujado (es lo que espera groups.ts).
      if (group && Math.abs(Number(gsap.getProperty(group, "scale")) - 1) > 0.01) return;

      const vh = window.innerHeight;
      const r = rail.getBoundingClientRect();
      const span = Math.max(r.height + (START - END) * vh, 1);
      gsap.set(fill, { scaleY: clamp01((START * vh - r.top) / span) });

      dots.forEach((dot) => {
        if (dot.getBoundingClientRect().top <= 0.65 * vh) revealDot(dot);
      });
      cards.forEach((card) => {
        if (card.getBoundingClientRect().top <= 0.78 * vh) revealCard(card);
      });
    });
  }
</script>
