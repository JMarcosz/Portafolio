---
// Galería completa de casos de estudio. Existe por dos razones:
//   1. Los casos eran huérfanos: sólo se enlazaban desde la home, que es una
//      página con túnel de scroll. Search Console los reportaba sin indexar.
//   2. `portafolio-conversion` (Paso 5) pide un enlace a la galería completa
//      antes de cambiar de sección: la home muestra 3, el resto vive acá.
import { getContent, normalizeLocale } from "../i18n";

const locale = normalizeLocale(Astro.currentLocale);
const t = getContent(locale);
const { projectsIndex: px, projects: p } = t;
---

<section class="mx-auto max-w-6xl section-y px-6">
  <p class="eyebrow mb-4">{px.eyebrow}</p>
  <h1 class="max-w-3xl text-4xl font-bold leading-[1.1] tracking-tight text-white md:text-5xl">
    {px.title}
  </h1>
  <p class="mt-6 max-w-2xl text-sm leading-relaxed text-white">{px.description}</p>

  <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      p.items.map((project) => (
        <article class="card flex flex-col overflow-hidden">
          <a href={project.href} tabindex="-1" class="block overflow-hidden">
            <img
              src={project.thumb}
              alt={`${project.title} — ${project.valueLine}`}
              width="1200"
              height="675"
              class="aspect-video w-full border-b border-white/10 object-cover object-top"
              loading="lazy"
              decoding="async"
            />
          </a>

          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <p class="eyebrow mb-3">{project.badge}</p>
              <h2 class="text-lg font-semibold">
                <a href={project.href} class="transition-opacity hover:opacity-80">{project.title}</a>
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-white">{project.valueLine}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="rounded-md bg-white/10 px-2 py-1 text-[11px] text-white">{tag}</span>
                ))}
              </div>
            </div>

            <div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-5">
              <a href={project.href} class="btn-primary w-full justify-center text-sm">
                {p.viewCase}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-white/15 px-4 py-2 text-sm font-medium text-white transition-colors hover:border-white/30 hover:bg-white/5"
              >
                {p.viewDemo}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H9M17 7v8" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <a href={t.home} class="mt-14 inline-flex items-center gap-2 text-sm text-white hover:underline">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
    {px.backHome}
  </a>
</section>
