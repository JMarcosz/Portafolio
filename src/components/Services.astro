---
import { getContent } from "../i18n";
const { services } = getContent(Astro.currentLocale);
---

<section id="servicios" aria-labelledby="servicios-title" class="mx-auto max-w-6xl section-y px-6">
  <p class="eyebrow mb-4">{services.eyebrow}</p>
  <h2 id="servicios-title" class="text-4xl font-bold tracking-tight">
    {services.heading1}<br />
    <span class="font-extrabold">{services.heading2}</span>
  </h2>
  <p class="mt-6 max-w-md text-sm leading-relaxed text-white/50">{services.intro}</p>

  <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2">
    {
      services.items.map((item, i) => (
        <article data-service-card class="card p-6">
          <span class="text-xs text-white/55">[ {String(i + 1).padStart(2, "0")} ]</span>
          <h3 class="mt-3 text-base font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/50">{item.description}</p>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap, TOKENS } from "../scripts/motion";
  import { registerSection } from "../scripts/stage";

  const cards = gsap.utils.toArray<HTMLElement>("[data-service-card]");

  registerSection("servicios", {
    prepare: () => gsap.set(cards, { autoAlpha: 0, y: 24 }),
    reveal: () => gsap.timeline().to(cards, { autoAlpha: 1, y: 0, stagger: TOKENS.stagger.normal, ...TOKENS.revealMd }),
    settle: () => gsap.set(cards, { autoAlpha: 1, y: 0 }),
  });
</script>
