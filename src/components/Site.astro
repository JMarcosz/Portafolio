---
import { getContent, normalizeLocale } from "../i18n";
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Projects from "./Projects.astro";
import Services from "./Services.astro";
import Process from "./Process.astro";
import Faq from "./Faq.astro";
import Experience from "./Experience.astro";
import Education from "./Education.astro";
import Certificates from "./Certificates.astro";
import Skills from "./Skills.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";

const locale = normalizeLocale(Astro.currentLocale);
const t = getContent(locale);
const site = "https://www.jeanmarte.com";

// JSON-LD propio de la home.
//
// El FAQPage es el que más rinde: es de los pocos rich results que Google sigue
// mostrando ampliamente, y la sección ya existe con preguntas y respuestas
// reales. Antes no se declaraba ninguno de los tres, así que Google tenía que
// inferir de un DOM donde además cuatro de cinco grupos llegaban ocultos.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: t.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Jean Marco Marte",
  url: `${site}/`,
  inLanguage: locale === "en" ? "en-US" : "es-DO",
};

// El <title> apunta a "RD" pero no había ninguna señal estructurada de negocio
// local: sin esto la sección de Servicios era texto suelto para Google.
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Jean Marco Marte — Desarrollo de software a medida",
  description: t.meta.description,
  url: `${site}${t.home}`,
  image: `${site}/og-image.jpg`,
  email: "mailto:jeanmarte22@gmail.com",
  address: { "@type": "PostalAddress", addressCountry: "DO" },
  areaServed: { "@type": "Country", name: "República Dominicana" },
  provider: { "@type": "Person", name: "Jean Marco Marte" },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: t.services.heading2,
    itemListElement: t.services.items.map((item) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: item.title, description: item.description },
    })),
  },
};
---

<Layout
  preloadImage={t.hero.photo}
  extraSchema={[websiteSchema, serviceSchema, faqSchema]}
>
  <Header />

  <!-- tabindex="-1": destino del enlace de salto, para que el foco aterrice acá
       y el siguiente Tab entre al contenido y no vuelva al nav. -->
  <main id="contenido" tabindex="-1" class="viewport-root">
    <!-- Orden de arriba a abajo: primero lo que el cliente necesita para decidir
         (quién soy, qué construí, qué ofrezco, cómo trabajo, qué le preocupa) y
         recién después el respaldo (experiencia, habilidades, formación). -->
    <div class="scroll-track" style="--groups: 5;">
      <div class="sticky-stage">
        <section class="scroll-group" data-group="0" data-nav="inicio">
          <div class="group-inner"><Hero /></div>
        </section>

        <section class="scroll-group" data-group="1" data-nav="sobre-mi">
          <div class="group-inner">
            <About />
            <Projects />
            <Services />
          </div>
        </section>

        <section class="scroll-group" data-group="2" data-nav="proceso">
          <div class="group-inner">
            <Process />
            <Faq />
          </div>
        </section>

        <section class="scroll-group" data-group="3" data-nav="experiencia">
          <div class="group-inner">
            <Experience />
            <Skills />
            <Education />
            <Certificates />
          </div>
        </section>

        <section class="scroll-group" data-group="4" data-nav="contacto">
          <div class="group-inner"><Contact /></div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
