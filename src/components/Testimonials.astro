---
// Testimonios reales, publicados textuales y atribuidos con nombre y negocio.
//
// La regla que gobierna esta sección: son citas DE ELLAS. Que Mary diga "ranking
// número 1" es su experiencia y se publica entrecomillada. Lo que el sitio no
// puede hacer es reformular esa cifra como promesa propia ("consigo el ranking
// #1") en el copy de alrededor: ahí dejaría de ser opinión del cliente y pasaría
// a ser una afirmación sin fuente.
import { getContent, normalizeLocale, projectPath } from "../i18n";

const locale = normalizeLocale(Astro.currentLocale);
const t = getContent(locale);
const { testimonials: tst } = t;
---

<section id="testimonios" aria-labelledby="testimonios-title" class="mx-auto max-w-6xl section-y px-6">
  <p class="eyebrow mb-4">{tst.eyebrow}</p>
  <h2 id="testimonios-title" class="text-4xl font-bold tracking-tight">
    {tst.heading1}<br />
    <span class="font-extrabold">{tst.heading2}</span>
  </h2>

  <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      tst.items.map((item) => (
        <figure data-testimonial class="card flex flex-col justify-between p-6">
          <blockquote class="text-sm leading-relaxed text-white">
            <p>“{item.quote}”</p>
          </blockquote>
          <figcaption class="mt-6 border-t border-white/10 pt-5">
            <p class="text-sm font-semibold text-white">{item.name}</p>
            <p class="text-xs text-white/70">{item.role}</p>
            {item.project && (
              <a
                href={projectPath(locale, item.project)}
                class="mt-3 inline-block text-xs font-medium text-white hover:underline"
              >
                {tst.seeCase} →
              </a>
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  import { gsap, TOKENS } from "../scripts/motion";
  import { registerSection } from "../scripts/stage";

  const cards = gsap.utils.toArray<HTMLElement>("[data-testimonial]");

  registerSection("testimonios", {
    prepare: () => gsap.set(cards, { autoAlpha: 0, y: 24 }),
    reveal: () =>
      gsap.timeline().to(cards, { autoAlpha: 1, y: 0, stagger: TOKENS.stagger.normal, ...TOKENS.revealMd }),
    settle: () => gsap.set(cards, { autoAlpha: 1, y: 0 }),
  });
</script>
